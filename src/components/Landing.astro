---
import '../styles/site.css'
import Playground from '../demos/Playground'
import Logo from './Logo.astro'
import FeatureDemo from '../features/FeatureDemo'
import { FEATURES } from '../features/copy'

const VERSION = process.env.KIRI_VERSION?.trim() || '0.3.2'
const RELEASES = 'https://github.com/abd3lraouf-studios/kiri-source/releases'
const UPSTREAM = 'https://github.com/Moltenship/kiri'
const F = FEATURES
const TITLE = 'Kiri: screenshot tool for Mac and Windows'
const DESCRIPTION = 'Capture, mark up and paste in seconds. Kiri has scrolling capture, text recognition, blur, measuring and pinning for macOS and Windows.'
const SITE_URL = Astro.site?.href
const OG_IMAGE = SITE_URL && new URL('/og.png', SITE_URL).href
const APP = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Kiri',
  description: DESCRIPTION,
  url: SITE_URL,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'macOS 15.2 or later, Windows 10 or later',
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/icon.png" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    {SITE_URL && <link rel="canonical" href={SITE_URL} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kiri" />
    {SITE_URL && <meta property="og:url" content={SITE_URL} />}
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    {OG_IMAGE && <>
      <meta property="og:image" content={OG_IMAGE} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content="The Kiri editor next to the line: Screenshot, mark it up, paste." />
      <meta name="twitter:card" content="summary_large_image" />
    </>}
    <script type="application/ld+json" set:html={JSON.stringify(APP)} />
    <script is:inline>
      try { const t = localStorage.getItem('kiri-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t } catch {}
      if (/^Win/.test(navigator.userAgentData?.platform ?? navigator.platform)) document.documentElement.dataset.os = 'windows'
    </script>
  </head>
  <body>
    <header class="nav">
      <a class="brand" href="/"><img src="/icon.png" width="28" height="28" alt="" />Kiri</a>
      <nav>
        <a href="#features">Features</a>
      </nav>
      <a class="btn btn--small" href="#platforms">Install</a>
    </header>

    <main>
      <section class="hero">
        <span class="eyebrow">Version {VERSION}</span>
        <h1>Screenshot, mark it&nbsp;up, paste.</h1>
        <p class="lede">
          Press <span data-for="mac"><kbd>⇧</kbd><kbd>⌘</kbd><kbd>2</kbd></span><span data-for="windows"><kbd>Ctrl</kbd><kbd>Shift</kbd><kbd>2</kbd></span>, drag, mark it up, then <kbd>Esc</kbd>. The image is on your clipboard.
          Click the editor below to take over.
        </p>
        <div class="ctas">
          <a class="btn" href="#platforms">Install Kiri</a>
        </div>
        <p class="platforms-line">
          <span class="platform"><Logo name="apple" size={13} />macOS 15.2+ on Apple Silicon</span>
          <span class="platform"><Logo name="windows" size={12} />Windows 10 and 11</span>
        </p>
      </section>

      <section class="demo">
        <Playground client:only="react" autoplay />
      </section>

      <section class="section" id="features">
        <h2>Everything a screenshot needs</h2>
        <div class="bento">
          <article class="tile span-4">
            <p class="tile-copy"><b>{F.scroll.title}.</b> {F.scroll.body}</p>
            <div class="tile-pic" data-ss-fill><FeatureDemo name="scroll" client:only="react" /></div>
          </article>
          {[[F.measure, 'span-2'], [F.redact, 'span-3'], [F.text, 'span-3'], [F.pin, 'span-3'], [F.backdrop, 'span-3']].map(([f, span]) => (
            <article class={`tile ${span}`}>
              <p class="tile-copy"><b>{f.title}.</b> {f.body}</p>
              <div class="tile-pic" data-ss-fill><FeatureDemo name={f.demo} client:only="react" /></div>
            </article>
          ))}
          <article class="tile span-3">
            <p class="tile-copy"><b>On-device editing.</b> Kiri processes screenshots and recognizes text on your computer.</p>
            <div class="net" aria-hidden="true">
              <div class="net-head"><img src="/icon.png" width="20" height="20" alt="" /><b>Kiri</b><span>Capture workflow</span></div>
              <div class="net-row">
                <span class="net-dot"></span>
                <span class="net-host"><b>Screenshot</b><code>Capture → Mark up → Copy</code></span>
                <span class="net-why">On device</span>
              </div>
            </div>
          </article>
          <article class="tile span-3">
            <p class="tile-copy"><b>Built on Kiri.</b> The <a href={UPSTREAM}>original MIT-licensed project</a> is by Timofey Maximov and Kiri contributors.</p>
            <div class="license" aria-hidden="true">
              <div class="license-page">
                <span class="license-file">LICENSE</span>
                <p class="license-title">MIT License</p>
                <p>Copyright (c) 2026 Timofey Maximov and Kiri contributors</p>
                <p class="license-body">Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the “Software”), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute…</p>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section class="section get" id="platforms">
        <img class="get-icon" src="/icon.png" width="96" height="96" alt="" />
        <h2>Get Kiri</h2>
        <p class="get-lede">Sign in to GitHub with access to the private repository to see available installers.</p>
        <div class="ctas">
          <a class="btn" href={RELEASES}><Logo name="github" />View private releases</a>
        </div>
        <ul class="os">
          <li data-ready><Logo name="apple" /><b>macOS</b><span>15.2+ on Apple Silicon</span></li>
          <li data-ready><Logo name="windows" /><b>Windows</b><span>10 and 11, x64</span></li>
        </ul>
      </section>
    </main>

    <footer class="foot">
      <span class="foot-brand"><img src="/icon.png" width="20" height="20" alt="" /> Kiri</span>
      <span class="foot-links">
        <span><a href={UPSTREAM}>Original project</a></span>
        <span class="theme" role="group" aria-label="Theme">
          <button type="button" data-set="auto">Auto</button>
          <button type="button" data-set="light">Light</button>
          <button type="button" data-set="dark">Dark</button>
        </span>
      </span>
    </footer>
    <script>
      const root = document.documentElement
      const buttons = document.querySelectorAll<HTMLButtonElement>('.theme button')
      const show = () => buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.set === (root.dataset.theme ?? 'auto'))))
      buttons.forEach((b) =>
        b.addEventListener('click', () => {
          const t = b.dataset.set!
          if (t === 'auto') delete root.dataset.theme
          else root.dataset.theme = t
          try { t === 'auto' ? localStorage.removeItem('kiri-theme') : localStorage.setItem('kiri-theme', t) } catch {}
          show()
        }),
      )
      show()
    </script>
  </body>
</html>
